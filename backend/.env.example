# Archivo: backend/.env.example
# Plantilla de variables de entorno del backend.
# Copiar a backend/.env y completar. backend/.env NUNCA se sube al repositorio.

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# URL desde la que se abre el frontend (CORS + Socket.io)
FRONTEND_URL=http://localhost:5173
# Orígenes extra separados por coma, p.ej. tablets en la LAN: http://192.168.1.50:5173
CORS_ORIGINS=
# Proxy de confianza para obtener la IP real (Nginx en el mismo servidor = loopback)
TRUST_PROXY=loopback

# ── Base de datos (valores de docker-compose.yml para desarrollo local) ──────
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=tuparley_user
DB_PASSWORD=tuparley_local_pass
DB_NAME=tuparley
DB_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# true para Redis gestionado con TLS (DigitalOcean)
REDIS_TLS=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# Obligatorio en producción (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=14h

# ── APIs de deportes (API-Sports, plan gratuito ~100 peticiones/día por API) ──
API_SPORTS_KEY=45f2d19dd61834d09e9acb00b17f6fe4
API_SPORTS_URL_FUTBOL=https://v3.football.api-sports.io
API_SPORTS_URL_BALONCESTO=https://v1.basketball.api-sports.io
API_SPORTS_URL_BEISBOL=https://v1.baseball.api-sports.io
API_SPORTS_URL_MMA=https://v1.mma.api-sports.io
# Tope diario de peticiones por API (deja margen bajo el límite del plan)
API_LIMITE_DIARIO=90
# Días hacia adelante que se sincronizan (1 petición por día y deporte)
DEPORTES_DIAS_SYNC=7
# true fuerza la sincronización de eventos en cada arranque (gasta cuota)
SYNC_AL_ARRANCAR=false

# ── API de tenis (RapidAPI) ───────────────────────────────────────────────────
API_TENNIS_KEY=7612a7c4c3mshf2a2e80991228d6p1b70f5jsn9014f92f9033
API_SPORTS_URL_TENIS=https://api-tennis.p.rapidapi.com

# ── API BCV ───────────────────────────────────────────────────────────────────
BCV_API_URL=https://ve.dolarapi.com/v1/dolares/oficial
# Fuente alternativa opcional, se usa si la principal falla (mismo formato o { price })
BCV_API_URL_RESPALDO=
# Rango aceptado para la tasa (API y carga manual)
BCV_RANGO_MINIMO=100
BCV_RANGO_MAXIMO=5000

# ── Apuestas (respaldo si no existen en configuracion_sistema) ───────────────
GANANCIA_MAXIMA_USD=300
APUESTA_MINIMA_USD=1

# ── Límites de peticiones ────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MIN=10
RATE_LIMIT_API_MIN=300
RATE_LIMIT_TICKETS_10S=5

# ── Almacenamiento (DigitalOcean Spaces, opcional) ───────────────────────────
SPACES_KEY=
SPACES_SECRET=
SPACES_ENDPOINT=
SPACES_BUCKET=
SPACES_REGION=nyc3
