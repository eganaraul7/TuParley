// Nombre de archivo: .env.example
// Ruta: backend/.env.example
// Función: Plantilla de variables de entorno para el backend

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=tuparley

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=cambiar_en_produccion
JWT_EXPIRES_IN=12h
JWT_REFRESH_SECRET=refresh_cambiar_en_produccion

# ── 2FA ───────────────────────────────────────────────────────────────────────
